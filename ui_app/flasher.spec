# -*- mode: python ; coding: utf-8 -*-
# PyInstaller spec for the TD-H9 Unbricker GUI (ui_app/app.py).
# PyInstaller spec для GUI-флешера TD-H9 (ui_app/app.py).
#
# Build / Сборка:
#   pyinstaller --noconfirm ui_app\flasher.spec
#
# Produces a single-file windowed EXE "h9_ui_flash.exe" that bundles app.py,
# the h9_flash core module and hidapi.dll, plus a Windows version resource
# generated by pyinstaller-versionfile from h9_ui_flash.yaml.
# Собирается onefile-windowed EXE "h9_ui_flash.exe", внутри которого app.py,
# модуль ядра h9_flash и hidapi.dll, плюс ресурс версии Windows, сгенерированный
# pyinstaller-versionfile из h9_ui_flash.yaml.

import os
import sys

# --- Paths / Пути ------------------------------------------------------------
# Directory of this spec (…/ui_app) / папка со spec (…/ui_app)
_SPEC_DIR = os.path.dirname(os.path.abspath(SPEC))
# Project root (parent of ui_app/) / корень проекта (родитель ui_app/)
_ROOT = os.path.dirname(_SPEC_DIR)

# Inputs / Входные файлы
_APP_MAIN = os.path.join(_SPEC_DIR, "app.py")       # GUI entry / точка входа GUI
_H9_MODULE = os.path.join(_ROOT, "h9_flash.py")     # core module / модуль ядра
_H9_HIDAPI_DLL = os.path.join(_ROOT, "hidapi.dll")  # native hidapi / нативная hidapi
_ICON = os.path.join(_ROOT, "h9_ui_flash.ico")      # application icon / иконка
_YAML = os.path.join(_ROOT, "h9_ui_flash.yaml")     # versionfile config / конфиг версии
_VERSION_TXT = os.path.join(_SPEC_DIR, "h9_ui_flash.txt")

# --- Auto-generate Windows version resource via pyinstaller-versionfile -------
# Настраиваем ресурс версии через pyinstaller-versionfile (как в build-exe.yml).
_VERSION_RESOURCE = None
if os.path.isfile(_YAML):
    try:
        import pyinstaller_versionfile
        pyinstaller_versionfile.create_version_file(
            src_file=_YAML, out_file=_VERSION_TXT,
        )
        if os.path.isfile(_VERSION_TXT):
            _VERSION_RESOURCE = _VERSION_TXT
    except Exception:
        _VERSION_RESOURCE = None
else:
    # If no YAML config is present, fall back to the checked-in txt if any,
    # otherwise no version resource. / Если YAML-конфига нет, берём готовый txt
    # (если он есть), иначе — без ресурса версии.
    if os.path.isfile(_VERSION_TXT):
        _VERSION_RESOURCE = _VERSION_TXT

# --- Data files bundled into the one-file archive -----------------------------
# (hidapi.dll at archive ROOT, so app.py can find it via sys._MEIPASS)
# Файлы данных, кладущиеся в архив onefile (hidapi.dll в КОРЕНЬ архива, чтобы
# app.py нашёл её через sys._MEIPASS).
_DATAS = []
if os.path.isfile(_H9_HIDAPI_DLL):
    _DATAS.append((_H9_HIDAPI_DLL, "."))
else:
    print("WARNING: hidapi.dll not found at %s" % _H9_HIDAPI_DLL, file=sys.stderr)

# Ensure the core module is importable during analysis / Модуль ядра доступен
# во время анализа: показываем корень проекта в pathex. PyInstaller сам найдёт
# h9_flash (app.py импортирует его), а также возьмёт hidapi как hidden import,
# если потребуется. Явно передаём h9_flash через `scripts`? Нет — через pathex
# он разрешится как обычный import.
_PY_PATH = [_ROOT, _SPEC_DIR] + list(sys.path)

a = Analysis(
    [_APP_MAIN],
    pathex=_PY_PATH,
    binaries=[],
    datas=_DATAS,
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="h9_ui_flash",          # output EXE name / имя выходного EXE
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,               # GUI app, no console window / GUI-приложение без консоли
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=_ICON if os.path.isfile(_ICON) else None,   # icon / иконка
    version=_VERSION_RESOURCE,   # Windows version resource / ресурс версии
)